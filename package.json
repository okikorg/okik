{
  "name": "okik",
  "version": "0.1.0",
  "description": "A modern CLI tool to simplify deployment and scaling of services on cloud platforms",
  "main": "dist/index.js",
  "bin": {
    "okik": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "watch": "tsc --watch",
    "clean": "rimraf dist",
    "prepare": "npm run build",
    "test": "jest",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write src/**/*.{ts,tsx}"
  },
  "keywords": ["cli", "cloud", "deployment", "kubernetes", "ai", "ml", "scaling"],
  "author": "Okik <hello@okik.ai>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/okikorg/okik.git"
  },
  "homepage": "https://okik.ai",
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "@inquirer/prompts": "^5.3.8",
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "express": "^4.18.2",
    "fastify": "^4.24.3",
    "figlet": "^1.7.0",
    "gradient-string": "^2.0.2",
    "ink": "^4.4.1",
    "ink-spinner": "^5.0.0",
    "ink-table": "^3.1.0",
    "js-yaml": "^4.1.0",
    "nanospinner": "^1.1.0",
    "ora": "^7.0.1",
    "picocolors": "^1.0.0",
    "react": "^18.2.0",
    "reflect-metadata": "^0.1.13",
    "terminal-kit": "^3.0.1",
    "winston": "^3.11.0",
    "yargs": "^17.7.2",
    "zod": "^3.22.4",
    "@kubernetes/client-node": "^0.20.0",
    "docker-compose": "^0.24.2",
    "dockerode": "^4.0.2",
    "uuid": "^9.0.1",
    "semver": "^7.5.4",
    "cross-spawn": "^7.0.3",
    "detect-port": "^1.5.1",
    "node-fetch": "^3.3.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.33",
    "@types/figlet": "^1.5.6",
    "@types/js-yaml": "^4.0.9",
    "@types/uuid": "^9.0.6",
    "@types/cross-spawn": "^6.0.4",
    "@types/ws": "^8.5.8",
    "@typescript-eslint/eslint-plugin": "^6.9.0",
    "@typescript-eslint/parser": "^6.9.0",
    "eslint": "^8.52.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.6",
    "prettier": "^3.0.3",
    "rimraf": "^5.0.5",
    "tsx": "^3.14.0",
    "typescript": "^5.2.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}